[Unit]
Description=dnsbench — DNS benchmark with a web UI
Documentation=file:///opt/dnsbench/README.md
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/dnsbench/dnsbench.conf
ExecStart=/opt/dnsbench/dnsbench
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dnsbench

# PAM has to read the shadow file, so the service runs as root; the rest is
# locked down.
StateDirectory=dnsbench
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
# The Updates page replaces the binary and the docs next to it; the rest of the system stays
# read-only. The leading "-" keeps the unit starting if the directory is ever absent.
ReadWritePaths=-/opt/dnsbench
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
